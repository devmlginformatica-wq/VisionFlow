# ═══════════════════════════════════════════════════════════
# VisionFlow — variáveis de ambiente do front
# ═══════════════════════════════════════════════════════════

# ─── API ─────────────────────────────────────────────────────
# URL que o front chama diretamente (sem proxy)
# Local:
VITE_API_BASE_URL=http://localhost:8080
# Produção (Cloudflare Tunnel):
# VITE_API_BASE_URL=https://api.programadordelphi.com.br

# URL que o proxy do Vite usa no `npm run dev`
# Local:
VITE_API_PROXY_TARGET=http://localhost:8080
# Produção (Cloudflare Tunnel):
# VITE_API_PROXY_TARGET=https://api.programadordelphi.com.br

# ─── Fonte de dados ──────────────────────────────────────────
# true = API real, false = mocks locais
VITE_USE_API=true
